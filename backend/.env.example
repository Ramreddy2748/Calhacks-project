# Demo works without credentials. Copy this file to backend/.env.
DATABASE_PATH=
DEMO_STEP_SECONDS=1.5
# Optional Claude planning and reporting; set a model available to your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Live calling is disabled until all of these are set.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
# Comma-separated E.164 teammate numbers. No other destinations are permitted.
ALLOWED_PHONE_NUMBERS=
# Browser voice: no phone number or private Vapi key is needed.
# Use Vapi's PUBLIC key here. Never put a private key in the frontend.
VAPI_PUBLIC_KEY=
# Optional dedicated browser assistant; otherwise VAPI_ASSISTANT_ID is used.
VAPI_BROWSER_ASSISTANT_ID=
# The assistant and request_approval tool must use the authenticated public
# webhook described in integrations/vapi-browser.md (VAPI_WEBHOOK_SECRET above).

# Optional SpacetimeDB mirror. The token must belong to the module publisher.
SPACETIMEDB_URL=
SPACETIMEDB_DATABASE=
SPACETIMEDB_TOKEN=
# Optional summary SMS. No SMS is sent automatically; UI confirmation is required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_TO=

# Hosted single-workspace access. Docker enables auth and fails to start unless
# the access key is 32+ characters and PUBLIC_APP_URL is an HTTPS origin.
HOLDON_REQUIRE_AUTH=0
HOLDON_ACCESS_KEY=
PUBLIC_APP_URL=

# Separate public planning-only agent, not the private call/approval agents.
AGENTVERSE_API_KEY=
AGENTVERSE_SEED=
AGENTVERSE_ENDPOINT=
AGENTVERSE_PORT=8001
