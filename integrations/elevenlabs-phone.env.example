# Add these to a protected phone-testing service, not the public simulation.
HOLDON_PUBLIC_DEMO=0
HOLDON_REQUIRE_AUTH=1
HOLDON_ACCESS_KEY=
PHONE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ID of the SIP number imported into ElevenLabs, not the E.164 number itself.
ELEVENLABS_PHONE_NUMBER_ID=
# Generated by ElevenLabs when creating the post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Generate a separate 32+ character secret for the approval tool.
ELEVENLABS_TOOL_SECRET=
# Comma-separated approved destination numbers, including country code.
ALLOWED_PHONE_NUMBERS=
